# Copy to .env for local development. Never commit a real .env file.

# --- Core -----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production only, e.g. https://ghanamarket.example
DJANGO_CSRF_TRUSTED_ORIGINS=
# Empty uses SQLite locally. Production: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
DEFAULT_COUNTRY=GH
DEFAULT_CURRENCY=GHS
# Absolute site URL used in notification emails.
SITE_URL=http://127.0.0.1:8000

# --- Payments ---------------------------------------------------------------
# "test" (development only, no real money), "paystack", or empty to disable online checkout.
# Defaults to "test" when DEBUG=True and to disabled when DEBUG=False.
PAYMENT_PROVIDER=test
# From the Paystack dashboard (Settings > API Keys). Use sk_test_... until you are ready to go live.
PAYSTACK_SECRET_KEY=
# Minutes a buyer has to pay before reserved stock is released.
CHECKOUT_EXPIRY_MINUTES=60

# --- Email ------------------------------------------------------------------
# Development prints emails to the console. Production requires SMTP settings.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GhanaMarket <no-reply@localhost>
NOTIFICATION_EMAILS_ENABLED=True
SUPPORT_EMAIL=

# --- Storage and caching ------------------------------------------------------
# Identity documents for seller verification. Must NOT be inside MEDIA_ROOT or web-served.
PRIVATE_MEDIA_ROOT=
# Shared cache so rate limits apply across all app workers, e.g. redis://localhost:6379/0
REDIS_URL=

# --- Production HTTPS and proxy (only when behind a trusted proxy/load balancer) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_PROXY_SSL_HEADER=False
DJANGO_TRUST_X_FORWARDED_FOR=False
# Enable HSTS only once the domain (and any included subdomains) are HTTPS-only.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO
